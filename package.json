{
  "name": "dukkanim-yanimda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "backup": "bash deploy/backup.sh",
    "build": "vite build && esbuild backend/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "dev": "tsx backend/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test": "node tests/test_ws.mjs",
    "test:auth": "python3 tests/test_auth.py",
    "test:features": "python3 tests/test_features.py",
    "test:ws": "node tests/test_ws.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "description": "Dukkanim Yanimda - kasa, veresiye, stok ve gun sonu yonetimi (esnaf paneli)"
}
