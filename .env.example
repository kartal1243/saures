# Kopyala -> .env ( izinleri 600 yap: chmod 600 .env). Git'e girmez.

# Gemini AI (VIP Esnaf Danışmanı + WhatsApp mesaj üretimi).
# Boş bırakılırsa uygulama hazır şablonlarla çalışmaya devam eder.
GEMINI_API_KEY="buraya_api_anahtarinı_yaz"

# Kullanılacak Gemini modeli. Varsayılan: gemini-3.8-flash
# (gemini-2.5-flash yeni anahtarlara kapalı, 404 döner).
GEMINI_MODEL="gemini-3.8-flash"
