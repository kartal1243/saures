# Kopyala -> .env (izinleri 600 yap: chmod 600 .env). Git'e girmez.

# Gemini AI (VIP Esnaf Danismani + Fiyat Tarifesi/Menu AI OCR + WhatsApp mesaj uretimi)
GEMINI_API_KEY="buraya_api_anahtarini_yaz"
GEMINI_MODEL="gemini-3.8-flash"

# /admin sayfasinin giris sifresi (guclu bir sifre yaz; bos birakilirsa /admin girisi kapali kalir!)
ADMIN_PASSWORD="buraya_guclu_sifre_yaz"

# ==============================================================================
# FIREBASE BLAZE (HARCADIKÇA ÖDE) ENTEGRASYONU
# ==============================================================================
# Firebase Proje ID, Firestore Database ID ve Web API Key (Phone Auth / E-posta Sifre Sifirlama)
FIREBASE_PROJECT_ID="dukkanim-yanimda"
FIREBASE_FIRESTORE_DATABASE_ID="default"
FIREBASE_API_KEY=""

# Blaze paketine gecildiginde SMS devre kesiciyi yuksek kotaya cikarir (true / false)
FIREBASE_BLAZE_ENABLED="true"
SMS_GLOBAL_DAILY_LIMIT="5000"

# Firebase Cloud Messaging (FCM HTTP v1) ve Firestore Service Account
# Secenek A: data/firebase-service-account.json dosyasinin yolu
# Secenek B: JSON icerigini tek satir veya base64 olarak FIREBASE_SERVICE_ACCOUNT_JSON icine koy
FIREBASE_SERVICE_ACCOUNT_PATH="data/firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Tarayici Web Push (Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=""

# Firebase App Check (Google Cloud Fraud Defense / reCAPTCHA Enterprise veya yedek v3 Site Key)
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
FIREBASE_APP_CHECK_SITE_KEY=""
VITE_FIREBASE_APP_CHECK_PROVIDER="enterprise"
# Dogrulamayi zorunlu kilmak icin "true" yap (Site Key tanimlandiktan sonra acin)
FIREBASE_APP_CHECK_ENFORCE="false"

# Firebase Cloud Storage & Realtime Database (Blaze)
FIREBASE_STORAGE_BUCKET="dukkanim-yanimda.firebasestorage.app"
FIREBASE_DATABASE_URL=""

# Firebase Blaze Cloud Functions (functions/index.js deploy edildiginde alinan HTTPS URL + guvenlik anahtari)
FIREBASE_SMS_FUNCTION_URL=""
FIREBASE_EMAIL_FUNCTION_URL=""
FIREBASE_FUNCTIONS_SECRET=""
FIREBASE_SMS_QUEUE_ACTIVE="false"
FIREBASE_EMAIL_QUEUE_ACTIVE="false"
APP_BASE_URL="https://dukkanimyanimda.com.tr"

# Kurumsal E-posta Saglayicilari (Resend / SendGrid / SMTP)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="Dükkanım Yanımda <support@dukkanimyanimda.com.tr>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Opsiyonel yedek: Legacy FCM key veya harici SMS ag gecidi (netgsm | iletimerkezi | vatansms | twilio | firebase | webhook)
FCM_SERVER_KEY=""
SMS_PROVIDER=""
SMS_USERCODE=""
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER="DUKKANIM"
SMS_WEBHOOK_URL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SUPPORT_WHATSAPP_PHONE=""

# Shopier OSB (Otomatik Siparis Bildirimi) Kullanici Adi ve Gizli Anahtari
SHOPIER_OSB_USER=""
SHOPIER_OSB_KEY=""

# Opsiyonel: Dahili webhook secret ve Telegram canli lead/odeme bildirimleri
WEBHOOK_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
LEAD_WEBHOOK_URL=""

# Opsiyonel: Gunluk yedek sifreleme parolasi ve Google Drive Apps Script yukleme URL'si
BACKUP_PASSPHRASE=""
GDRIVE_WEBHOOK_URL=""
