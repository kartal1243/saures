# Kopyala -> .env (izinleri 600 yap: chmod 600 .env). Git'e girmez.

# Gemini AI (VIP Esnaf Danismani + Fiyat Tarifesi/Menu AI OCR + WhatsApp mesaj uretimi)
GEMINI_API_KEY="buraya_api_anahtarini_yaz"
